# Copiar a apps/api/.env para desarrollo local. Nunca commitear apps/api/.env.
# La base es Neon (PostgreSQL administrado) — no hay Postgres local ni
# contenedor propio. Los roles `migrator`/`app_user` se crean corriendo
# apps/api/prisma/init/01-roles.sql a mano contra el proyecto Neon.

# Usado por `prisma migrate` / `prisma db seed` — dueño del schema, BYPASSRLS.
# Endpoint directo de Neon (no pooled): las migraciones usan advisory
# locks/DDL que no son confiables a través de PgBouncer en modo transacción.
DATABASE_URL="postgresql://migrator:<password>@<endpoint>.neon.tech/neondb?sslmode=require&schema=public"

# Usado en runtime por el PrismaService de NestJS (Fase 2 en adelante).
# Rol ordinario, totalmente sujeto a Row-Level Security — todo el modelo
# de aislamiento multi-tenant depende de que la app se conecte con ESTE
# rol, nunca con el de DATABASE_URL/migrator, para queries de request.
# Endpoint pooled de Neon (host "-pooler", PgBouncer en modo transacción);
# pgbouncer=true deshabilita prepared statements con nombre, requerido por
# PgBouncer en ese modo.
APP_DATABASE_URL="postgresql://app_user:<password>@<endpoint>-pooler.neon.tech/neondb?sslmode=require&schema=public&pgbouncer=true"

PORT=3000

# Fase 2 — firma de access tokens (JwtStrategy/AuthService). Generar con
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# El refresh token no usa secreto propio: es opaco (id de fila +
# validador aleatorio, hasheado con argon2 en la tabla refresh_tokens),
# no un JWT firmado -- ver AuthService.issueTokensWithId().
JWT_ACCESS_SECRET="<generar-valor-aleatorio>"

# Fase 6 — NotificationsModule (push vía expo-server-sdk).
# EXPO_ACCESS_TOKEN es opcional (solo necesario si la cuenta de Expo tiene
# "enhanced security" activado); sin él, expo-server-sdk igual funciona.
EXPO_ACCESS_TOKEN=""
# PUSH_ENABLED=false apaga el envío real (PushService.sendAsync() vuelve
# []) sin tocar código -- útil en desarrollo/CI para no gastar la cuota de
# Expo con reportes de prueba.
PUSH_ENABLED=true

# Fase 6 — MetricsModule (date_trunc por día). IANA tz name; default
# pensado para un call center operando en Argentina -- cambiar si no
# corresponde, ver plan-fase-6.md (D4).
METRICS_TZ="America/Argentina/Buenos_Aires"

# Fase 8 — endurecimiento y despliegue (plan-fase-8.md).

# 'development' | 'test' | 'production'. Controla: nivel/formato del log
# de pino (silent en test, pretty fuera de producción), si CORS_ORIGINS es
# obligatoria (solo en production, ver env.validation.ts), y si helmet /
# el resto de la config asume que hay un proxy real delante (Render).
NODE_ENV=development

# CSV de orígenes permitidos para CORS (HTTP y el gateway de sockets,
# mismo valor para los dos -- ver RealtimeIoAdapter). Sin esta variable,
# el fallback de desarrollo es "http://localhost:5173,http://localhost:8081"
# (Vite + expo start --web). En producción es OBLIGATORIA (env.validation.ts
# corta el arranque si falta) -- va acá el dominio real de admin-web.
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# Rate limiting (D1, @nestjs/throttler). THROTTLE_ENABLED=false deja el
# guard registrado pero inerte -- así corren las 10 suites e2e existentes
# (~35 logins reales por corrida, misma IP, en serie; un límite real las
# rompería). El criterio de aceptación "fuerza bruta bloqueada" lo cubre
# test/throttler.e2e-spec.ts, que levanta su propia instancia con el
# límite encendido -- no depende de este flag.
THROTTLE_ENABLED=true
# Límite estricto solo para POST /auth/login y /auth/refresh.
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL=60
# Límite general para el resto de los endpoints.
THROTTLE_GLOBAL_LIMIT=120
THROTTLE_GLOBAL_TTL=60

# Nivel de log de pino (nestjs-pino). Ignorado si NODE_ENV=test (silent
# forzado -- si no, las 10 suites e2e quedan ilegibles bajo un muro de
# JSON). Valores: fatal|error|warn|info|debug|trace.
LOG_LEVEL=info
