// Prisma schema — Fase 1 (ver plan.md raíz).
// Convención: columnas y tablas en snake_case en Postgres vía @map/@@map,
// campos camelCase en el cliente TS (coincide con packages/shared/src/types.ts).
// Las políticas RLS (prisma/migrations/*_enable_rls/migration.sql) son SQL
// crudo escrito a mano y asumen estos nombres de columna/tabla exactos.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // El resto de apps/api es CommonJS (sin "type": "module" en package.json,
  // nest build/start corre sobre dist/*.js con require()) -- sin esto el
  // cliente generado sale ESM por defecto y "nest start" revienta con
  // "exports is not defined" apenas algo importa este cliente.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  super_admin
  supervisor
  agent
  client_user

  @@map("role")
}

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

enum UserStatus {
  active
  inactive
  blocked

  @@map("user_status")
}

enum CampaignStatus {
  active
  paused

  @@map("campaign_status")
}

model Tenant {
  id                String       @id @default(uuid())
  name              String
  status            TenantStatus @default(active)
  editWindowMinutes Int          @default(30) @map("edit_window_minutes")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  memberships TenantMembership[]
  campaigns   Campaign[]
  callReports CallReport[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  role         Role
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenantMemberships   TenantMembership[]
  campaignAssignments CampaignAgent[]
  callReportsAsAgent  CallReport[]       @relation("CallReportAgent")
  resolvedFollowups   CallReport[]       @relation("CallReportFollowupResolver")
  auditLogs           AuditLog[]
  pushTokens          PushToken[]
  shifts              Shift[]            @relation("ShiftUser")
  shiftsClosed        Shift[]            @relation("ShiftClosedBy")
  refreshTokens       RefreshToken[]

  @@map("users")
}

model TenantMembership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("tenant_memberships")
}

model Campaign {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  name      String
  status    CampaignStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents       CampaignAgent[]
  dispositions Disposition[]
  callReports  CallReport[]

  @@index([tenantId])
  @@map("campaigns")
}

// isActive en vez de borrar la fila al desasignar un agente: app_user
// nunca recibe GRANT DELETE en ninguna tabla (ver
// prisma/init/01-roles.sql -- "la aplicación nunca borra filas
// físicamente, usa flags de estado"), mismo criterio que closedBy/endedAt
// en Shift. Reasignar el mismo agente a la misma campaña reactiva la fila
// existente (upsert) en vez de violar el @@unique de abajo.
model CampaignAgent {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  userId     String   @map("user_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@map("campaign_agents")
}

model Disposition {
  id               String  @id @default(uuid())
  campaignId       String  @map("campaign_id")
  label            String
  // Slug estable (venta, cita, consulta, mensaje, seguimiento, reclamo,
  // no_interesado, otro) usado por el frontend para íconos/colores/métricas
  // en vez de comparar la etiqueta en español. Nullable: las tipificaciones
  // que crea un admin desde el panel no llevan code.
  code             String?
  sortOrder        Int     @default(0) @map("sort_order")
  requiresFollowup Boolean @default(false) @map("requires_followup")
  requiresDetail   Boolean @default(false) @map("requires_detail")
  requiresSchedule Boolean @default(false) @map("requires_schedule")
  isActive         Boolean @default(true) @map("is_active")
  color            String?
  icon             String?

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  callReports CallReport[]

  @@unique([campaignId, code])
  @@index([campaignId])
  @@map("dispositions")
}

model CallReport {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  campaignId         String    @map("campaign_id")
  agentId            String    @map("agent_id")
  dispositionId      String    @map("disposition_id")
  contactName        String    @map("contact_name")
  contactPhone       String    @map("contact_phone")
  contactEmail       String?   @map("contact_email")
  notes              String?
  followupResolvedAt DateTime? @map("followup_resolved_at")
  followupResolvedBy String?   @map("followup_resolved_by")
  durationSeconds    Int?      @map("duration_seconds")
  externalCallId     String?   @map("external_call_id")
  recordingUrl       String?   @map("recording_url")
  // Nullable en el esquema (reportes históricos y ediciones de supervisor no
  // siempre cuelgan de un turno), pero la política RLS de INSERT del agente
  // (ver migración shifts_rls) exige un turno abierto propio -- el bloqueo
  // "sin turno no se reporta" vive en la base, no solo en la UI.
  shiftId            String?   @map("shift_id")
  scheduledAt        DateTime? @map("scheduled_at")
  detailText         String?   @map("detail_text")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign         Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agent            User        @relation("CallReportAgent", fields: [agentId], references: [id])
  disposition      Disposition @relation(fields: [dispositionId], references: [id])
  followupResolver User?       @relation("CallReportFollowupResolver", fields: [followupResolvedBy], references: [id])
  shift            Shift?      @relation(fields: [shiftId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, dispositionId])
  @@index([agentId, createdAt])
  @@index([tenantId, scheduledAt])
  @@map("call_reports")
}

// Registro de jornada del agente (clock in/out). No lleva tenant_id: un
// turno es del call center, no de una empresa cliente -- los client_user no
// tienen ninguna política RLS sobre esta tabla y por lo tanto no ven turnos.
model Shift {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  // Supervisor que cerró un turno olvidado (clock-out manual desde el panel).
  closedBy  String?   @map("closed_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user        User         @relation("ShiftUser", fields: [userId], references: [id], onDelete: Cascade)
  closer      User?        @relation("ShiftClosedBy", fields: [closedBy], references: [id])
  callReports CallReport[]

  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("shifts")
}

// Inmutable por diseño: sin updatedAt, y REVOKE UPDATE/DELETE para
// app_user en la migración RLS (ver 01-roles.sql + enable_rls).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  diff       Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model PushToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  platform   String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// Sesiones de refresh token (Fase 2). Sin tenant_id ni RLS: se consulta
// ANTES de que exista un contexto de usuario autenticado (login/refresh),
// así que AuthService usa el cliente base de PrismaService directamente
// en vez de forUser(). Rotación: cada uso de un refresh token válido lo
// marca revoked (revokedAt + replacedById) y emite uno nuevo. Nunca se
// borra físicamente (ver 01-roles.sql: sin DELETE global para app_user) —
// "revocado" es un flag, no una fila ausente, para poder detectar reuso
// de un token ya rotado (señal de robo) incluso después de rotarlo.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
