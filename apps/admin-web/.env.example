# Copiar a apps/admin-web/.env para desarrollo local.

# 'mock' (default si se omite) usa los datos en memoria de src/mocks/seed.ts.
# 'real' es el modo que la Fase 3 conecta contra el API de NestJS — hoy
# todavía no existen endpoints CRUD que consumir, así que este modo solo
# deja avisado por consola que falta implementarse (ver AppStore.tsx).
VITE_API_MODE=mock

# Usado únicamente cuando VITE_API_MODE=real (Fase 3 en adelante).
VITE_API_URL=http://localhost:3000
